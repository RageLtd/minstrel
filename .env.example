# Copy to .env and fill in. Compose reads .env automatically.

# --- Required ---
# Navidrome credentials. The analyzer reads the library via the Subsonic API and
# the orchestrator writes playlists, both authenticating as this user.
NAVIDROME_USER=admin
NAVIDROME_PASS=change-me

# --- Optional (defaults shown) ---
# Your existing Ollama server. The default reaches one on the Docker host;
# point it at a LAN address if it lives on another box.
OLLAMA_URL=http://host.docker.internal:11434

# Ollama model tag for query translation (must already be pulled on your server).
MINSTREL_MODEL=qwen3.6:35b-a3b

# Ollama thinking channel (default true). Reasoning-first models (GLM 5.x,
# qwen3.x) return empty narrations with it off; set false only to trade
# reliability for latency.
MINSTREL_THINK=true

# Host path where your NAS music is mounted; bind-mounted read-only into Navidrome.
MUSIC_PATH=/mnt/music

# Published ports
NAVIDROME_PORT=4533
ORCHESTRATOR_PORT=3000
